{
    "compilerOptions": {
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodeNext",
        "strict": true,
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "outDir": "dist",
        "rootDir": "src"
    },
    "include": ["src"]
}