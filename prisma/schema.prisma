generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}
datasource db {
  provider = "sqlite"
}
model Room {
  id Int @id @default(autoincrement())
  name String @unique
  capacity Int
  bookings Booking[]
}
model Booking{
  id Int @id @default(autoincrement())
  startsAt DateTime
  endsAt DateTime
  userId Int
  room Room @relation(fields: [roomId], references: [id])
  roomId Int
}